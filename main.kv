#:import MDDivider kivymd.uix.divider.MDDivider
#:import SwipeScreenManager views.ui_components.SwipeScreenManager

<CharakterVerwaltungScreen>:
    CharakterVerwaltungWidget:
        id: charakter_verwaltung_widget

<EinstellungenScreen>:
    EinstellungenWidget:
        id: einstellungen_widget

<VoelkerScreen>:
    VoelkerWidget:
        id: voelker_widget

<ProfilScreen>:
    ProfilWidget:
        id: profil_widget

<EigenschaftenScreen>:
    EigenschaftenWidget:
        id: eigenschaften_widget

<HandicapsScreen>:
    HandicapsWidget:
        id: handicaps_widget

<TalenteScreen>:
    TalenteWidget:
        id: talente_widget

<MaechteScreen>:
    MaechteWidget:
        id: maechte_widget

<SuperkraefteScreen>:
    SuperkraefteWidget:
        id: superkraefte_widget

<AusruestungScreen>:
    AusruestungWidget:
        id: ausruestung_widget

<CharakterbogenScreen>:
    CharakterbogenWidget:
        id: charakterbogen_widget

<HistorieScreen>:
    HistorieWidget:
        id: historie_widget

<InfoScreen>:
    orientation: 'vertical'
    padding: dp(10)
    spacing: dp(10)

    ScrollView:
        size_hint: (1, 1)
        do_scroll_x: False
        do_scroll_y: True
        bar_width: dp(15)
        bar_margin: dp(8)
        scroll_wheel_distance: dp(114)

        MDBoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            md_bg_color: app.theme_cls.backgroundColor
            height: self.minimum_height
            padding: dp(10)
            spacing: dp(10)

            MDLabel:
                text: root.info_text
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None
                halign: 'left'
                valign: 'top'            
          
            # Linktasten
            MDBoxLayout:
                id: link_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)

MDScreen:
    # Floating Navigation Button (Portrait-Modus)
    MDFabButton:
        id: portrait_nav_fab
        icon: "menu"
        style: "small"
        size_hint: None, None
        size: dp(44), dp(44)
        pos_hint: {'right': 0.97, 'y': 0.02}
        opacity: 0
        disabled: True
        on_release: app.toggle_navigation_rail()

    # Wir packen alles in eine einzige vertikale MDBoxLayout-Struktur
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: app.theme_cls.backgroundColor

        # ----------------- (1) OBERE MENÜLEISTE (TABS) -----------------
        MDBoxLayout:
            id: tabs_container
            orientation: 'vertical'
            size_hint_y: None
            height: dp(60)  # Höhe der Tabbar
            padding: [dp(4), 0, 0, 0]
            md_bg_color: app.theme_cls.backgroundColor
            MDTabsPrimary:
                id: tabs_bar
                # In "on_start" füllen wir hier MDTabsItem rein.

        # ----------------- (2) HORIZONTALES LAYOUT: NAV-RAIL + CONTENT -----------------
        MDBoxLayout:
            orientation: 'horizontal'

            # Menü-Toggle-Button (nur im Mobile-Modus sichtbar)
            # KEIN disabled auf Container-Ebene - Android propagiert das nicht
            # zuverlässig an Kinder. width=0 + opacity=0 reicht zum Verstecken.
            MDBoxLayout:
                id: menu_toggle_container
                orientation: 'vertical'
                size_hint_x: None
                width: 0
                opacity: 0
                padding: [0, dp(8), 0, dp(8)]

                MDIconButton:
                    id: menu_toggle_btn
                    icon: "menu"
                    style: "filled"
                    size_hint: None, None
                    size: dp(56), dp(56)
                    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                    on_release: app.toggle_navigation_rail()

            # NavigationRail (initial versteckt)
            # KEIN disabled - Android-Kompatibilität (width=0 reicht)
            MDBoxLayout:
                id: nav_rail_container
                orientation: 'vertical'
                size_hint_x: None
                width: 0
                opacity: 0
                md_bg_color: app.theme_cls.surfaceContainerColor

                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True
                    bar_width: dp(4)
                    bar_margin: dp(2)

                    MDBoxLayout:
                        id: nav_rail_box
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(4)
                        padding: [0, dp(8), 0, dp(8)]

            # Hauptinhalt (Pointbar + ScreenManager + Logger)
            MDBoxLayout:
                orientation: 'vertical'
                id: main_content_area

                # ----------------- POINTBAR -------------------
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    md_bg_color: app.theme_cls.backgroundColor

                    GenerationPointsBar:
                        id: generation_points
                        charakter: app.controller.charakter

                # ----------------- TAB-INHALT (CAROUSEL) -------------------
                MDBoxLayout:
                    orientation: 'vertical'
                    id: tab_content_box
                    padding: [30, 0, 30, 30]
                    size_hint_y: 1  # Füllt den restlichen Platz
                    md_bg_color: app.theme_cls.backgroundColor

                    SwipeScreenManager:
                        id: tabs_carousel
                        size_hint: (1, 1)
                        # Screens werden dynamisch hinzugefügt.

                # ----------------- LOGGER (unten) -------------------
                MDBoxLayout:
                    id: logger_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(60)
                    md_bg_color: app.theme_cls.backgroundColor

                    TextInput:
                        id: logger_label
                        text: "Logger: Keine neuen Nachrichten"
                        readonly: True
                        multiline: True
                        background_color: (0, 0, 0, 0)
                        foreground_color: (1, 1, 1, 1)
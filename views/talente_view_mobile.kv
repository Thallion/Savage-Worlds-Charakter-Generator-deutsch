# talente_view_mobile.kv - Smartphone-optimiertes Layout
# Beschreibungen ausgeblendet im RecycleView, nur per Info-Button erreichbar
# Kompakte Zeilen: Name + Rang + Buttons in einer Zeile

<TooltipIconButton>
    MDTooltipPlain:
        text: root.tooltip_text

<TooltipFabButton>
    MDTooltipPlain:
        text: root.tooltip_text

<TalenteWidget>:
    orientation: 'vertical'
    md_bg_color: self.theme_cls.backgroundColor

    # Suchfeld kompakt
    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(64)
        padding: [dp(8), dp(6)]
        spacing: dp(6)

        MDTextField:
            id: search_input
            hint_text: 'Suche...'
            size_hint_x: 1
            on_text: root.filter_talente()

        MDIconButton:
            id: filter_chevron
            icon: "chevron-down" if root.is_filter_expanded else "chevron-right"
            size_hint: None, None
            width: dp(40)
            height: dp(40)
            pos_hint: {'center_y': 0.5}
            on_release: root.toggle_filter_panel()

    # Filter-Buttons kompakt, horizontal scrollbar
    MDScrollView:
        id: filter_container
        size_hint_y: None
        height: dp(56)
        do_scroll_x: True
        do_scroll_y: False

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_x: None
            width: self.minimum_width
            size_hint_y: None
            height: dp(48)
            padding: [dp(8), dp(4)]
            spacing: dp(6)

            TooltipFabButton:
                id: sort_name_btn
                tooltip_text: "Name"
                icon: "sort-alphabetical-ascending" if root.current_sort_option != 'Name' or root.sort_order == 'asc' else "sort-alphabetical-descending"
                style: "small"
                size_hint: None, None
                size: dp(40), dp(40)
                on_release: root.update_sort_option('Name')

            TooltipFabButton:
                id: sort_rank_btn
                tooltip_text: "Rang"
                icon: "sort-ascending" if root.current_sort_option != 'Rang' or root.sort_order == 'asc' else "sort-descending"
                style: "small"
                size_hint: None, None
                size: dp(40), dp(40)
                on_release: root.update_sort_option('Rang')

            TooltipFabButton:
                id: sort_category_btn
                tooltip_text: "Kategorie"
                icon: "sort-reverse-variant" if root.current_sort_option != 'Kategorie' or root.sort_order == 'asc' else "sort-variant"
                style: "small"
                size_hint: None, None
                size: dp(40), dp(40)
                on_release: root.update_sort_option('Kategorie')

            MDButton:
                id: only_selected_button
                size_hint: None, None
                height: dp(40)
                on_release: root.toggle_only_selected_items()

                MDButtonText:
                    text: "Gewählt" if not root.only_selected_items else "Alle"
                    theme_text_color: "Primary" if not root.only_selected_items else "Custom"
                    text_color: self.theme_cls.primaryColor if root.only_selected_items else self.theme_cls.onSurfaceColor
                    font_size: dp(12)

            MDButton:
                id: only_available_button
                size_hint: None, None
                height: dp(40)
                on_release: root.toggle_only_available_talents()

                MDButtonText:
                    text: "Voraus." if not root.only_available_talents else "Alle"
                    theme_text_color: "Primary" if not root.only_available_talents else "Custom"
                    text_color: self.theme_cls.primaryColor if root.only_available_talents else self.theme_cls.onSurfaceColor
                    font_size: dp(12)

            MDFabButton:
                icon: "filter"
                style: "small"
                size_hint: None, None
                size: dp(40), dp(40)
                on_release: root.open_category_menu()

            MDLabel:
                id: category_label
                text: 'Alle Kategorien'
                size_hint_x: None
                width: dp(80)
                font_size: dp(12)
                shorten: True
                shorten_from: 'right'
                text_size: self.size

    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(32)
        padding: [dp(8), dp(4)]

        MDLabel:
            text: 'Talente'
            font_size: dp(18)
            halign: 'left'
            bold: True

    TalenteRecycleView:
        id: recycleview
        viewclass: 'TalentItemRow'
        size_hint_y: 1

        RecycleBoxLayout:
            id: layout
            default_size: None, dp(48)
            default_size_hint: 1, None
            size_hint_y: None
            height: self.minimum_height
            orientation: 'vertical'
            spacing: dp(2)
            padding: [dp(4), dp(4)]

# Kompakte Talent-Zeile: Name | Kategorie | Rang | +/- Buttons | Info
# KEINE Beschreibung inline - nur per Info-Button
<TalentItemRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(48)
    md_bg_color: self._get_background_color()
    line_color: self._get_line_color()
    line_width: 2
    spacing: dp(4)
    padding: [dp(6), dp(4)]

    # Name - nimmt verfügbaren Platz
    MDLabel:
        text: root.talent_name
        font_size: dp(13)
        size_hint_x: 1
        halign: 'left'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'
        text_size: self.size

    # Kategorie kompakt
    MDLabel:
        text: root.kategorie
        font_size: dp(11)
        size_hint_x: None
        width: dp(50)
        halign: 'left'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'
        text_size: self.size

    # Rang kompakt
    MDLabel:
        text: root.rang
        font_size: dp(12)
        size_hint_x: None
        width: dp(24)
        halign: 'center'
        valign: 'middle'

    # Action-Buttons kompakt
    MDFabButton:
        icon: "plus"
        style: "small"
        size_hint: None, None
        size: dp(36), dp(36)
        pos_hint: {"center_y": 0.5}
        on_release: root.waehle_talent()

    MDFabButton:
        icon: "minus"
        style: "small"
        size_hint: None, None
        size: dp(36), dp(36)
        pos_hint: {"center_y": 0.5}
        on_release: root.entferne_talent()
        disabled: not root.ausgewaehlt

    MDFabButton:
        icon: "pencil"
        style: "small"
        size_hint: None, None
        size: dp(36), dp(36)
        pos_hint: {"center_y": 0.5}
        on_release: root.bearbeite_talent()

    # Info-Button für Beschreibung (ersetzt inline-Beschreibung)
    MDFabButton:
        icon: "information-outline"
        style: "small"
        size_hint: None, None
        size: dp(32), dp(32)
        pos_hint: {"center_y": 0.5}
        on_release: root.show_full_description()

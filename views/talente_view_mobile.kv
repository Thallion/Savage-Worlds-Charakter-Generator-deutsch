# talente_view_mobile.kv - Smartphone-optimiertes Layout
# Beschreibungen ausgeblendet im RecycleView, nur per Info-Button erreichbar
# Kompakte Zeilen: Name + Rang + Buttons in einer Zeile

<TooltipIconButton>
    MDTooltipPlain:
        text: root.tooltip_text

<TooltipFabButton>
    MDTooltipPlain:
        text: root.tooltip_text

<TalenteWidget>:
    orientation: 'vertical'
    md_bg_color: self.theme_cls.backgroundColor

    # Suchfeld und Filter-Buttons in einer Zeile, horizontal scrollbar
    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(44)
        padding: [dp(4), dp(2)]
        spacing: dp(4)

        MDTextField:
            id: search_input
            hint_text: 'Suche...'
            size_hint_x: None
            width: dp(110)
            on_text: root.filter_talente()

        MDScrollView:
            id: filter_container
            size_hint_x: 1
            do_scroll_x: True
            do_scroll_y: False

            MDBoxLayout:
                orientation: 'horizontal'
                size_hint_x: None
                width: self.minimum_width
                size_hint_y: None
                height: dp(40)
                spacing: dp(4)

                MDFabButton:
                    icon: "filter"
                    style: "small"
                    size_hint: None, None
                    size: dp(36), dp(36)
                    on_release: root.open_category_menu()

                MDLabel:
                    id: category_label
                    text: 'Alle Kategorien'
                    size_hint_x: None
                    width: dp(80)
                    font_size: dp(11)
                    shorten: True
                    shorten_from: 'right'
                    text_size: self.size

                TooltipFabButton:
                    id: only_selected_button
                    tooltip_text: "Nur ausgewählte / Alle"
                    icon: "sort-bool-descending-variant" if not root.only_selected_items else "sort-bool-ascending-variant"
                    style: "small"
                    size_hint: None, None
                    size: dp(36), dp(36)
                    on_release: root.toggle_only_selected_items()

                TooltipFabButton:
                    id: only_available_button
                    tooltip_text: "Voraussetzung erfüllt / Alle"
                    icon: "account-key" if not root.only_available_talents else "key-minus"
                    style: "small"
                    size_hint: None, None
                    size: dp(36), dp(36)
                    on_release: root.toggle_only_available_talents()

                TooltipFabButton:
                    id: sort_name_btn
                    tooltip_text: "Name"
                    icon: "sort-alphabetical-ascending" if root.current_sort_option != 'Name' or root.sort_order == 'asc' else "sort-alphabetical-descending"
                    style: "small"
                    size_hint: None, None
                    size: dp(36), dp(36)
                    on_release: root.update_sort_option('Name')

                TooltipFabButton:
                    id: sort_rank_btn
                    tooltip_text: "Rang"
                    icon: "sort-numeric-ascending" if root.current_sort_option != 'Rang' or root.sort_order == 'asc' else "sort-numeric-descending"
                    style: "small"
                    size_hint: None, None
                    size: dp(36), dp(36)
                    on_release: root.update_sort_option('Rang')

                TooltipFabButton:
                    id: sort_category_btn
                    tooltip_text: "Kategorie"
                    icon: "sort-bool-ascending" if root.current_sort_option != 'Kategorie' or root.sort_order == 'asc' else "sort-bool-descending"
                    style: "small"
                    size_hint: None, None
                    size: dp(36), dp(36)
                    on_release: root.update_sort_option('Kategorie')

    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(28)
        padding: [dp(4), dp(2)]

        MDLabel:
            text: 'Talente'
            font_size: dp(16)
            halign: 'left'
            bold: True

    TalenteRecycleView:
        id: recycleview
        viewclass: 'TalentItemRow'
        size_hint_y: 1

        RecycleBoxLayout:
            id: layout
            default_size: None, dp(38)
            default_size_hint: 1, None
            size_hint_y: None
            height: self.minimum_height
            orientation: 'vertical'
            spacing: dp(2)
            padding: [dp(2), dp(2)]

# Kompakte Talent-Zeile: Name | Kategorie | Rang | +/- Buttons | Info
<TalentItemRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(38)
    md_bg_color: self._get_background_color()
    line_color: self._get_line_color()
    line_width: 2
    spacing: dp(2)
    padding: [dp(4), dp(2)]

    # Name - responsiv mit Obergrenze
    MDLabel:
        text: root.talent_name
        font_size: dp(13)
        size_hint_x: None
        width: min(dp(260), self.parent.width - dp(220)) if self.parent else dp(200)
        halign: 'left'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'
        text_size: self.size

    # Kategorie - breiter im Landscape
    MDLabel:
        text: root.kategorie
        font_size: dp(11)
        size_hint_x: None
        width: dp(70) if (self.parent and self.parent.width > dp(400)) else dp(44)
        halign: 'left'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'
        text_size: self.size

    # Rang kompakt
    MDLabel:
        text: root.rang
        font_size: dp(11)
        size_hint_x: None
        width: dp(18)
        halign: 'center'
        valign: 'middle'

    # Action-Buttons kompakt
    MDFabButton:
        icon: "plus"
        style: "small"
        size_hint: None, None
        size: dp(30), dp(30)
        pos_hint: {"center_y": 0.5}
        on_release: root.waehle_talent()

    MDFabButton:
        icon: "minus"
        style: "small"
        size_hint: None, None
        size: dp(30), dp(30)
        pos_hint: {"center_y": 0.5}
        on_release: root.entferne_talent()
        disabled: not root.ausgewaehlt

    MDFabButton:
        icon: "pencil"
        style: "small"
        size_hint: None, None
        size: dp(30), dp(30)
        pos_hint: {"center_y": 0.5}
        on_release: root.bearbeite_talent()

    # Info-Button
    MDFabButton:
        icon: "information-outline"
        style: "small"
        size_hint: None, None
        size: dp(28), dp(28)
        pos_hint: {"center_y": 0.5}
        on_release: root.show_full_description()

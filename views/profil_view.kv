<ProfilWidget>:
    orientation: 'vertical'
    padding: [10, 10, 10, 10]
    spacing: 10
    md_bg_color: self.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: 'vertical'
        padding: [10, 10, 10, 10]
        spacing: 10

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '60dp'
            spacing: 10
            adaptive_height: True

            MDLabel:
                text: "Name:"
                size_hint_x: None
                width: 150
                halign: 'left'
                theme_text_color: "Primary"

            MDTextField:
                id: name_input
                hint_text: "Name eingeben"
                size_hint_x: 1
                text: root.char_name
                on_text: root.on_char_name_change(root, self.text)

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '60dp'
            spacing: 10
            adaptive_height: True

            MDLabel:
                text: "Alter:"
                size_hint_x: None
                width: 150
                halign: 'left'
                theme_text_color: "Primary"

            MDTextField:
                id: alter_input
                hint_text: "Alter eingeben"
                size_hint_x: 1
                text: root.alter
                on_text: root.on_alter_change(root, self.text)

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '60dp'
            spacing: 10
            adaptive_height: True

            MDLabel:
                text: "Geschlecht:"
                size_hint_x: None
                width: 150
                halign: 'left'
                theme_text_color: "Primary"

            MDTextField:
                id: geschlecht_input
                hint_text: "Geschlecht eingeben"
                size_hint_x: 1
                text: root.geschlecht
                on_text: root.on_geschlecht_change(root, self.text)

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '60dp'
            spacing: 10
            adaptive_height: True

            MDLabel:
                text: "Konzept:"
                size_hint_x: None
                width: 150
                halign: 'left'
                theme_text_color: "Primary"

            MDTextField:
                id: konzept_input
                hint_text: "Konzept eingeben"
                size_hint_x: 1
                text: root.konzept
                on_text: root.on_konzept_change(root, self.text)

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '60dp'
            spacing: 10
            adaptive_height: True

            MDLabel:
                text: "Sprachen:"
                size_hint_x: None
                width: 150
                halign: 'left'
                theme_text_color: "Primary"

            MDTextField:
                id: sprachen_input
                hint_text: "Sprachen eingeben"
                size_hint_x: 1
                text: root.sprachen
                on_text: root.on_sprachen_change(root, self.text)
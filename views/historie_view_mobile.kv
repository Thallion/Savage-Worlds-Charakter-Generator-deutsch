# historie_view_mobile.kv - Smartphone-optimiertes Layout
# Kompaktere Elemente, proportionale Button-Anordnung
# Gleiche Widget-IDs wie Desktop-Version

#:import dp kivy.metrics.dp

<HistorieWidget>:
    orientation: 'vertical'
    padding: dp(6)
    spacing: dp(6)

    # Kompakter Header: Titel + Auto-Log Switch in einer Zeile
    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(40)
        spacing: dp(8)

        MDLabel:
            text: "[b]Charakter-Historie[/b]"
            markup: True
            font_size: "18sp"
            size_hint_x: 1

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_x: None
            width: dp(110)
            spacing: dp(4)

            MDLabel:
                text: "Auto-Log:"
                size_hint_x: None
                width: dp(65)
                font_size: "13sp"

            MDSwitch:
                id: auto_log_switch
                active: True

    # Buttons in einer Zeile, gleichmäßig verteilt
    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(44)
        spacing: dp(6)

        MDButton:
            style: "tonal"
            size_hint_x: 1
            on_release: root._save_history(self)

            MDButtonText:
                text: "Speichern"

        MDButton:
            style: "tonal"
            size_hint_x: 1
            on_release: root._clear_history(self)

            MDButtonText:
                text: "Löschen"

        MDButton:
            style: "tonal"
            size_hint_x: 1
            on_release: root._export_full_history(self)

            MDButtonText:
                text: "Exportieren"

    # Divider
    MDDivider:

    # Kompakte Statistik-Karte
    MDCard:
        id: stats_card
        orientation: 'vertical'
        padding: dp(8)
        size_hint_y: None
        height: dp(110)
        md_bg_color: (0.1, 0.1, 0.1, 1)

        MDLabel:
            text: "[b]Session-Statistik:[/b]"
            markup: True
            size_hint_y: None
            height: dp(24)
            font_size: "14sp"

        MDLabel:
            id: stats_text
            text: "Keine Daten verfügbar"
            size_hint_y: None
            height: dp(70)
            font_size: "13sp"

    # Log-Anzeige (ScrollView mit Label) - nimmt restlichen Platz
    MDScrollView:
        size_hint: (1, 1)
        do_scroll_x: False
        do_scroll_y: True
        bar_width: dp(20)
        bar_margin: dp(4)
        scroll_type: ['bars', 'content']

        MDLabel:
            id: log_display
            text: ""
            font_size: "12sp"
            size_hint_y: None
            height: self.texture_size[1] + dp(20)
            text_size: self.width, None
            color: (1, 1, 1, 1)
            padding: [dp(8), dp(8)]

    # Filter-Zeile kompakt
    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(48)
        spacing: dp(6)

        MDTextField:
            id: filter_input
            hint_text: "Suche in Historie..."
            mode: "outlined"
            size_hint_x: 1

#:import MDDivider kivymd.uix.divider.MDDivider

# einstellungen_widget_mobile.kv - Smartphone-optimiertes Layout
# Keine MDCards (blockieren Scrolling auf Android), stattdessen Sections mit Divider
# Gleiche Widget-Klasse und IDs wie Desktop-Version

<EinstellungenWidget>:
    MDScrollView:
        size_hint: (1, 1)
        do_scroll_x: False
        do_scroll_y: True
        scroll_timeout: 200
        scroll_distance: dp(20)
        bar_width: dp(20)
        bar_margin: dp(4)
        scroll_type: ['bars', 'content']

        MDBoxLayout:
            orientation: 'vertical'
            spacing: dp(8)
            padding: [dp(8), dp(8), dp(8), dp(8)]
            size_hint_y: None
            height: self.minimum_height

            # ===== Theme und Farben =====
            MDBoxLayout:
                orientation: 'vertical'
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(4), dp(8)]

                # Theme Controls
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)

                    MDLabel:
                        text: 'Theme:'
                        size_hint_y: None
                        height: dp(28)

                    MDSegmentedButton:
                        size_hint_x: 1

                        MDSegmentedButtonItem:
                            size_hint_x: 0.5
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.switch_theme_style('Light')

                            MDSegmentButtonLabel:
                                text: "Hell"

                        MDSegmentedButtonItem:
                            size_hint_x: 0.5
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.switch_theme_style('Dark')

                            MDSegmentButtonLabel:
                                text: "Dunkel"

                # Farbschema
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)

                    MDLabel:
                        text: 'Farbschema:'
                        size_hint_y: None
                        height: dp(28)

                    MDGridLayout:
                        id: colors_box
                        cols: 5
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(6)
                        padding: dp(4)

                # Vertikales Menü Toggle
                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(48)
                    spacing: dp(8)

                    MDLabel:
                        text: 'Vertikales Menü:'
                        size_hint_x: 1
                        pos_hint: {"center_y": .5}

                    MDSwitch:
                        id: mobile_modus_switch
                        pos_hint: {"center_y": .5}
                        on_active: root.toggle_mobile_modus(self.active)

                # Tablet-Layout Toggle (nur auf Android sichtbar)
                MDBoxLayout:
                    id: tablet_layout_box
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(48)
                    spacing: dp(8)

                    MDLabel:
                        text: 'Tablet-Layout (Desktop-Ansicht):'
                        size_hint_x: 1
                        pos_hint: {"center_y": .5}

                    MDSwitch:
                        id: tablet_layout_switch
                        pos_hint: {"center_y": .5}
                        on_active: root.toggle_tablet_layout(self.active)

                # Neustart-Hinweis Tablet-Layout
                MDBoxLayout:
                    id: tablet_layout_hint_box
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(24)
                    spacing: dp(8)

                    MDLabel:
                        text: "(Neustart erforderlich)"
                        theme_text_color: "Secondary"
                        font_style: "Body"
                        role: "small"
                        pos_hint: {"center_y": .5}

                # Orientierung fixieren Toggle
                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(48)
                    spacing: dp(8)

                    MDLabel:
                        text: 'Orientierung fixieren:'
                        size_hint_x: 1
                        pos_hint: {"center_y": .5}

                    MDSwitch:
                        id: orientation_lock_switch
                        pos_hint: {"center_y": .5}
                        on_active: root.toggle_orientation_lock(self.active)

                # Orientierungs-Auswahl (nur sichtbar wenn fixiert)
                MDBoxLayout:
                    id: orientation_choice_box
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)

                    MDLabel:
                        text: 'Orientierung:'
                        size_hint_y: None
                        height: dp(28)

                    MDSegmentedButton:
                        id: orientation_segment
                        size_hint_x: 1

                        MDSegmentedButtonItem:
                            size_hint_x: 0.5
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.set_orientation('portrait')

                            MDSegmentButtonLabel:
                                text: "Portrait"

                        MDSegmentedButtonItem:
                            size_hint_x: 0.5
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.set_orientation('landscape')

                            MDSegmentButtonLabel:
                                text: "Landscape"

                # Logger-Leiste Toggle
                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(48)
                    spacing: dp(8)

                    MDLabel:
                        text: 'Logger anzeigen:'
                        size_hint_x: 1
                        pos_hint: {"center_y": .5}

                    MDSwitch:
                        id: show_logger_switch
                        pos_hint: {"center_y": .5}
                        on_active: root.toggle_logger(self.active)

                # Neustart- und Schließen-Buttons
                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(48)
                    spacing: dp(8)
                    padding: [0, dp(8), 0, 0]

                    MDButton:
                        style: "tonal"
                        size_hint_x: 1
                        size_hint_y: None
                        height: dp(40)
                        on_release: root.restart_app()

                        MDButtonIcon:
                            icon: "restart"

                        MDButtonText:
                            text: "Neu starten"

                    MDButton:
                        style: "outlined"
                        size_hint_x: 1
                        size_hint_y: None
                        height: dp(40)
                        on_release: root.close_app()

                        MDButtonIcon:
                            icon: "close"

                        MDButtonText:
                            text: "Schließen"

            MDDivider:

            # ===== Spielelemente =====
            MDBoxLayout:
                orientation: 'vertical'
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(4), dp(8)]

                MDLabel:
                    text: "Spielelemente"
                    bold: True
                    size_hint_y: None
                    height: dp(32)

                # Statistik-Anzeige
                MDBoxLayout:
                    id: element_stats_box
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(4)

                # Abstammungen
                MDLabel:
                    text: "Abstammungen"
                    bold: True
                    size_hint_y: None
                    height: dp(28)
                    font_size: dp(13)

                MDGridLayout:
                    cols: 2
                    spacing: dp(6)
                    size_hint_y: None
                    height: dp(48)

                    MDButton:
                        style: "elevated"
                        size_hint_x: 1
                        on_release: root.open_add_volk_dialog()
                        MDButtonIcon:
                            icon: "plus"
                        MDButtonText:
                            text: "Hinzufügen"

                    MDButton:
                        style: "outlined"
                        size_hint_x: 1
                        on_release: root.open_delete_volk_dialog()
                        MDButtonIcon:
                            icon: "delete"
                        MDButtonText:
                            text: "Löschen"

                # Talente
                MDLabel:
                    text: "Talente"
                    bold: True
                    size_hint_y: None
                    height: dp(28)
                    font_size: dp(13)

                MDGridLayout:
                    cols: 2
                    spacing: dp(6)
                    size_hint_y: None
                    height: dp(48)

                    MDButton:
                        style: "elevated"
                        size_hint_x: 1
                        on_release: root.open_add_talent_popup()
                        MDButtonIcon:
                            icon: "plus"
                        MDButtonText:
                            text: "Hinzufügen"

                    MDButton:
                        style: "outlined"
                        size_hint_x: 1
                        on_release: root.open_delete_talent_popup()
                        MDButtonIcon:
                            icon: "delete"
                        MDButtonText:
                            text: "Löschen"

                # Mächte
                MDLabel:
                    text: "Mächte"
                    bold: True
                    size_hint_y: None
                    height: dp(28)
                    font_size: dp(13)

                MDGridLayout:
                    cols: 2
                    spacing: dp(6)
                    size_hint_y: None
                    height: dp(48)

                    MDButton:
                        style: "elevated"
                        size_hint_x: 1
                        on_release: root.open_add_macht_popup()
                        MDButtonIcon:
                            icon: "plus"
                        MDButtonText:
                            text: "Hinzufügen"

                    MDButton:
                        style: "outlined"
                        size_hint_x: 1
                        on_release: root.open_delete_macht_popup()
                        MDButtonIcon:
                            icon: "delete"
                        MDButtonText:
                            text: "Löschen"

                # Fertigkeiten
                MDLabel:
                    text: "Fertigkeiten"
                    bold: True
                    size_hint_y: None
                    height: dp(28)
                    font_size: dp(13)

                MDGridLayout:
                    cols: 2
                    spacing: dp(6)
                    size_hint_y: None
                    height: dp(48)

                    MDButton:
                        style: "elevated"
                        size_hint_x: 1
                        on_release: root.open_add_fertigkeit_popup()
                        MDButtonIcon:
                            icon: "plus"
                        MDButtonText:
                            text: "Hinzufügen"

                    MDButton:
                        style: "outlined"
                        size_hint_x: 1
                        on_release: root.open_delete_fertigkeit_popup()
                        MDButtonIcon:
                            icon: "delete"
                        MDButtonText:
                            text: "Löschen"

                # Handicaps
                MDLabel:
                    text: "Handicaps"
                    bold: True
                    size_hint_y: None
                    height: dp(28)
                    font_size: dp(13)

                MDGridLayout:
                    cols: 2
                    spacing: dp(6)
                    size_hint_y: None
                    height: dp(48)

                    MDButton:
                        style: "elevated"
                        size_hint_x: 1
                        on_release: root.open_add_handicap_popup()
                        MDButtonIcon:
                            icon: "plus"
                        MDButtonText:
                            text: "Hinzufügen"

                    MDButton:
                        style: "outlined"
                        size_hint_x: 1
                        on_release: root.open_delete_handicap_popup()
                        MDButtonIcon:
                            icon: "delete"
                        MDButtonText:
                            text: "Löschen"

                # Ausrüstung
                MDLabel:
                    text: "Ausrüstung"
                    bold: True
                    size_hint_y: None
                    height: dp(28)
                    font_size: dp(13)

                MDGridLayout:
                    cols: 2
                    spacing: dp(6)
                    size_hint_y: None
                    height: dp(48)

                    MDButton:
                        style: "elevated"
                        size_hint_x: 1
                        on_release: root.open_add_ausruestung_popup()
                        MDButtonIcon:
                            icon: "package-variant"
                        MDButtonText:
                            text: "Allgemein"

                    MDButton:
                        style: "elevated"
                        size_hint_x: 1
                        on_release: root.open_add_waffe_popup()
                        MDButtonIcon:
                            icon: "sword"
                        MDButtonText:
                            text: "Waffen"

                MDGridLayout:
                    cols: 2
                    spacing: dp(6)
                    size_hint_y: None
                    height: dp(48)

                    MDButton:
                        style: "elevated"
                        size_hint_x: 1
                        on_release: root.open_add_ruestung_popup()
                        MDButtonIcon:
                            icon: "shield"
                        MDButtonText:
                            text: "Rüstungen"

                    MDButton:
                        style: "elevated"
                        size_hint_x: 1
                        on_release: root.open_add_schild_popup()
                        MDButtonIcon:
                            icon: "shield-outline"
                        MDButtonText:
                            text: "Schilde"

                # Lösch-Buttons für Ausrüstung
                MDGridLayout:
                    cols: 2
                    spacing: dp(6)
                    size_hint_y: None
                    height: dp(96)

                    MDButton:
                        style: "outlined"
                        size_hint_x: 1
                        on_release: root.open_delete_ausruestung_popup()
                        MDButtonIcon:
                            icon: "delete"
                        MDButtonText:
                            text: "Allg. lösch."

                    MDButton:
                        style: "outlined"
                        size_hint_x: 1
                        on_release: root.open_delete_waffe_popup()
                        MDButtonIcon:
                            icon: "delete"
                        MDButtonText:
                            text: "Waffe lösch."

                    MDButton:
                        style: "outlined"
                        size_hint_x: 1
                        on_release: root.open_delete_ruestung_popup()
                        MDButtonIcon:
                            icon: "delete"
                        MDButtonText:
                            text: "Rüst. lösch."

                    MDButton:
                        style: "outlined"
                        size_hint_x: 1
                        on_release: root.open_delete_schild_popup()
                        MDButtonIcon:
                            icon: "delete"
                        MDButtonText:
                            text: "Schild lösch."

            MDDivider:

            # ===== Tutorial =====
            MDBoxLayout:
                orientation: 'vertical'
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "Hilfe & Tutorial"
                    bold: True
                    size_hint_y: None
                    height: dp(40)

                MDButton:
                    style: "filled"
                    size_hint_x: 1
                    on_release: root.open_tutorial()

                    MDButtonIcon:
                        icon: "book-open-variant"

                    MDButtonText:
                        text: "Tutorial starten"


            MDDivider:

            # ===== Log =====
            MDButton:
                style: "filled"
                size_hint_x: 1
                on_release: root.open_log_file()

                MDButtonIcon:
                    icon: "content-copy"

                MDButtonText:
                    text: "Log kopieren"

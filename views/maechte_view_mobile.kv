# maechte_view_mobile.kv - Smartphone-optimiertes Layout
# Beschreibungen ausgeblendet, nur per Info-Button erreichbar
# Kompakte Zeilen: Name | Rang | MP-Info | Buttons

<TooltipIconButton>
    MDTooltipPlain:
        text: root.tooltip_text

<TooltipFabButton>
    MDTooltipPlain:
        text: root.tooltip_text

# Hauptdefinition für KraefteWidget
<KraefteWidget>:
    orientation: 'vertical'
    md_bg_color: self.theme_cls.backgroundColor

# Rückwärtskompatibilität: MaechteWidget als Alias
<MaechteWidget@KraefteWidget>:

    # Suchfeld und Filter-Buttons in einer Zeile, horizontal scrollbar
    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(44)
        padding: [dp(4), dp(2)]
        spacing: dp(4)

        MDTextField:
            id: search_input
            hint_text: 'Suche...'
            size_hint_x: None
            width: dp(110)
            on_text: root.filter_maechte()

        MDScrollView:
            id: filter_container
            size_hint_x: 1
            do_scroll_x: True
            do_scroll_y: False

            MDBoxLayout:
                orientation: 'horizontal'
                size_hint_x: None
                width: self.minimum_width
                size_hint_y: None
                height: dp(40)
                spacing: dp(4)

                TooltipFabButton:
                    id: only_selected_button
                    tooltip_text: "Nur ausgewählte / Alle"
                    icon: "sort-bool-descending-variant" if not root.only_selected_items else "sort-bool-ascending-variant"
                    style: "small"
                    size_hint: None, None
                    size: dp(36), dp(36)
                    on_release: root.toggle_only_selected_items()

                TooltipFabButton:
                    id: sort_name_btn
                    tooltip_text: "Name"
                    icon: "sort-alphabetical-ascending" if root.current_sort_option != 'Name' or root.sort_order == 'asc' else "sort-alphabetical-descending"
                    style: "small"
                    size_hint: None, None
                    size: dp(36), dp(36)
                    on_release: root.update_sort_option('Name')

                TooltipFabButton:
                    id: sort_rank_btn
                    tooltip_text: "Rang"
                    icon: "sort-numeric-ascending" if root.current_sort_option != 'Rang' or root.sort_order == 'asc' else "sort-numeric-descending"
                    style: "small"
                    size_hint: None, None
                    size: dp(36), dp(36)
                    on_release: root.update_sort_option('Rang')

    MDLabel:
        text: 'Mächte'
        font_size: dp(16)
        size_hint_y: None
        height: dp(28)
        padding: [dp(4), dp(2)]
        bold: True

    MaechteRecycleView:
        id: recycleview
        viewclass: 'MachtItemRow'
        size_hint_y: 1
        bar_width: dp(20)
        bar_margin: dp(4)
        scroll_type: ['bars', 'content']

        RecycleBoxLayout:
            id: layout
            default_size: None, dp(38)
            default_size_hint: 1, None
            size_hint_y: None
            height: self.minimum_height
            orientation: 'vertical'
            spacing: dp(2)
            padding: [dp(2), dp(2)]

# Kompakte Macht-Zeile: Name | Rang | MP | Buttons | Info
<MachtItemRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(38)
    md_bg_color: self._get_background_color()
    line_color: self._get_line_color()
    line_width: 2
    spacing: dp(2)
    padding: [dp(4), dp(2)]

    # Name - responsiv mit Obergrenze
    MDLabel:
        text: root.macht_name
        font_size: dp(11)
        size_hint_x: None
        width: min(dp(260), self.parent.width - dp(220)) if self.parent else dp(200)
        halign: 'left'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'
        text_size: self.size

    # Rang kompakt
    MDLabel:
        text: root.rang
        font_size: dp(9)
        size_hint_x: None
        width: dp(16)
        halign: 'center'
        valign: 'middle'

    # MP kompakt - im Portrait ausgeblendet (Platzsparen)
    MDLabel:
        text: f"MP:{root.machtpunkte}"
        font_size: dp(10)
        size_hint_x: None
        width: dp(42) if (self.parent and self.parent.width > dp(400)) else 0
        opacity: 1 if (self.parent and self.parent.width > dp(400)) else 0
        halign: 'center'
        valign: 'middle'

    # Action-Buttons
    MDFabButton:
        icon: "plus"
        style: "small"
        size_hint: None, None
        size: dp(30), dp(30)
        pos_hint: {"center_y": 0.5}
        on_release: root.waehle_macht()
        disabled: root.macht and root.macht.ausgewaehlt

    MDFabButton:
        icon: "minus"
        style: "small"
        size_hint: None, None
        size: dp(30), dp(30)
        pos_hint: {"center_y": 0.5}
        on_release: root.entferne_macht()
        disabled: not root.macht or not root.macht.ausgewaehlt

    MDFabButton:
        icon: "pencil"
        style: "small"
        size_hint: None, None
        size: dp(30), dp(30)
        pos_hint: {"center_y": 0.5}
        on_release: root.bearbeite_macht()

    # Info-Button
    MDFabButton:
        icon: "information-outline"
        style: "small"
        size_hint: None, None
        size: dp(28), dp(28)
        pos_hint: {"center_y": 0.5}
        on_release: root.show_full_description()

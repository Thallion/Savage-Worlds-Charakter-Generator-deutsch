<TooltipIconButton>
    MDTooltipPlain:
        text: root.tooltip_text

<TooltipFabButton>
    MDTooltipPlain:
        text: root.tooltip_text

# Hauptdefinition für KraefteWidget
<KraefteWidget>:
    orientation: 'vertical'
    md_bg_color: self.theme_cls.backgroundColor

# Rückwärtskompatibilität: MaechteWidget als Alias
<MaechteWidget@KraefteWidget>:
    
    # Suchfeld mit Chevron-Button zum Ein-/Ausklappen der Filter
    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(100)
        padding: [20, 10]
        spacing: 10

        MDTextField:
            id: search_input
            hint_text: 'Suche...'
            size_hint_x: 1
            on_text: root.filter_maechte()

        MDIconButton:
            id: filter_chevron
            icon: "chevron-down" if root.is_filter_expanded else "chevron-right"
            size_hint: None, None
            width: dp(40)
            height: dp(40)
            pos_hint: {'center_y': 0.5}
            on_release: root.toggle_filter_panel()

    # Toggle-Buttons in ScrollView für Android-Kompatibilität
    MDScrollView:
        id: filter_container
        size_hint_y: None
        height: dp(120)
        do_scroll_x: False
        do_scroll_y: True
        bar_width: dp(15)
        bar_margin: dp(8)

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(120)
            padding: [20, 10]
            spacing: 10

            TooltipFabButton:
                id: sort_name_btn
                tooltip_text: "Sortieren nach Name"
                icon: "sort-alphabetical-ascending" if root.current_sort_option != 'Name' or root.sort_order == 'asc' else "sort-alphabetical-descending"
                style: "small"
                size_hint: None, None
                size: dp(56), dp(56)
                pos_hint: {"center_y": 0.5}
                on_release: root.update_sort_option('Name')

            TooltipFabButton:
                id: sort_rank_btn
                tooltip_text: "Sortieren nach Rang"
                icon: "sort-ascending" if root.current_sort_option != 'Rang' or root.sort_order == 'asc' else "sort-descending"
                style: "small"
                size_hint: None, None
                size: dp(56), dp(56)
                pos_hint: {"center_y": 0.5}
                on_release: root.update_sort_option('Rang')

            # Button für "Nur ausgewählte" (Android Checkbox Workaround)
            MDButton:
                id: only_selected_button
                size_hint_x: None
                size_hint_y: None
                width: dp(180)
                height: dp(56)
                pos_hint: {"center_y": 0.5}
                on_release: root.toggle_only_selected_items()

                MDButtonText:
                    text: "Nur ausgewählte" if not root.only_selected_items else "Alle"
                    theme_text_color: "Primary" if not root.only_selected_items else "Custom"
                    text_color: self.theme_cls.primaryColor if root.only_selected_items else self.theme_cls.onSurfaceColor

    MDLabel:
        text: 'Mächte'
        font_size: dp(24)
        size_hint_y: None
        height: dp(48)
        padding: [20, 10]

    MaechteRecycleView:
        id: recycleview
        viewclass: 'MachtItemRow'
        size_hint_y: 1
        
        RecycleBoxLayout:
            id: layout
            default_size: None, dp(60)
            default_size_hint: 1, None
            size_hint_y: None
            height: self.minimum_height
            orientation: 'vertical'
            spacing: dp(5)
            padding: dp(20)

<MachtItemRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(60)
    md_bg_color: self._get_background_color()
    line_color: self._get_line_color()
    line_width: 2
    spacing: dp(10)
    padding: dp(10)

    MDLabel:
        text: root.macht_name
        font_size: dp(16)
        size_hint_x: 0.2
        halign: 'left'
        valign: 'middle'

    MDLabel:
        text: root.rang
        font_size: dp(16)
        size_hint_x: 0.05
        halign: 'left'
        valign: 'middle'

    MDLabel:
        text: f"MP: {root.machtpunkte} / RW: {root.reichweite} / Dauer: {root.dauer}"
        font_size: dp(14)
        size_hint_x: 0.15
        halign: 'left'
        valign: 'middle'

    MDFabButton:
        icon: "plus"
        style: "small"
        size_hint: None, None
        size: dp(40), dp(40)
        pos_hint: {"center_y": 0.5}
        on_release: root.waehle_macht()
        disabled: root.macht and root.macht.ausgewaehlt

    MDFabButton:
        icon: "minus"
        style: "small"
        size_hint: None, None
        size: dp(40), dp(40)
        pos_hint: {"center_y": 0.5}
        on_release: root.entferne_macht()
        disabled: not root.macht or not root.macht.ausgewaehlt

    # Neuer Bearbeiten-Button
    MDFabButton:
        icon: "pencil"
        style: "small"
        size_hint: None, None
        size: dp(40), dp(40)
        pos_hint: {"center_y": 0.5}
        on_release: root.bearbeite_macht()

    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_x: 0.55
        spacing: dp(5)
        
        MDLabel:
            text: root.beschreibung
            font_size: dp(14)
            halign: 'left'
            valign: 'top'
            text_size: self.width, None
            markup: True
            max_lines: 2
            
        MDFabButton:
            icon: "information-outline"
            style: "small"
            size_hint: None, None
            size: dp(32), dp(32)
            pos_hint: {"center_y": 0.5}
            on_release: root.show_full_description()
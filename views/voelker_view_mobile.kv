# voelker_view_mobile.kv - Smartphone-optimiertes Layout
# Popup-Auswahl mit Suchfeld statt Inline-Liste
# Gleiche Widget-Klasse und IDs wie Desktop-Version

<VoelkerWidget>:
    orientation: 'vertical'
    md_bg_color: self.theme_cls.backgroundColor
    padding: [dp(8), dp(6), dp(8), dp(6)]
    spacing: dp(8)

    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(32)
        
        MDLabel:
            text: "Abstammungen"
            size_hint_x: 1
            halign: 'left'
            font_style: "Title"
            theme_text_color: "Primary"
            bold: True

        # Buttons für Abstammungs-Management
        MDIconButton:
            icon: "plus"
            tooltip: "Abstammung erstellen"
            on_release: root.open_add_volk_dialog()

        MDIconButton:
            id: edit_volk_button
            icon: "pencil"
            tooltip: "Abstammung bearbeiten"
            on_release: root.open_edit_volk_dialog()

        MDIconButton:
            icon: "delete"
            tooltip: "Abstammung löschen"
            on_release: root.open_delete_volk_dialog()

    # Kompakte Abstammungs-Auswahl mit Button
    MDCard:
        size_hint_x: 1
        size_hint_y: None
        height: dp(64)
        padding: dp(10)
        elevation: 2
        radius: [10]
        md_bg_color: self.theme_cls.surfaceContainerLowColor
        style: "elevated"

        MDBoxLayout:
            orientation: 'horizontal'
            spacing: dp(10)

            MDLabel:
                text: "Abstammung:"
                font_style: "Body"
                theme_text_color: "Primary"
                size_hint_x: 0.2
                halign: 'left'
                valign: 'center'

            MDButton:
                id: volk_dropdown_button
                style: "outlined"
                size_hint_x: 0.8
                size_hint_y: None
                height: dp(44)
                on_release: root.open_volk_dropdown()

                MDButtonText:
                    id: selected_volk_text
                    text: "Abstammung auswählen..."

    # Abstammungs-Details ScrollView - Zusatzelemente und Details zusammen scrollbar
    MDScrollView:
        size_hint_y: 1
        do_scroll_x: False
        do_scroll_y: True
        bar_width: dp(20)
        bar_margin: dp(4)
        scroll_type: ['bars', 'content']
        scroll_timeout: 200
        scroll_distance: dp(20)

        MDBoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(8)
            padding: [dp(4), dp(6), dp(4), dp(6)]

            # Zusatzelemente Container (ENTWEDER/ODER Auswahlen)
            MDBoxLayout:
                id: zusatzelemente_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)

            # Volk-Details Container
            MDBoxLayout:
                id: selected_volk_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)

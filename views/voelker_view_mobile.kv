# voelker_view_mobile.kv - Smartphone-optimiertes Layout
# Inline-Liste mit Suchfeld statt Dropdown für bessere Bedienbarkeit
# Gleiche Widget-Klasse und IDs wie Desktop-Version

<VoelkerWidget>:
    orientation: 'vertical'
    md_bg_color: self.theme_cls.backgroundColor
    padding: [dp(8), dp(6), dp(8), dp(6)]
    spacing: dp(8)

    MDLabel:
        text: "Völker"
        size_hint_y: None
        height: dp(32)
        halign: 'left'
        font_style: "Title"
        theme_text_color: "Primary"
        bold: True

    # Suchfeld für Völker-Filter
    MDTextField:
        id: search_input
        mode: "outlined"
        size_hint_x: 1
        size_hint_y: None
        height: dp(48)
        on_text: root.filter_voelker()

        MDTextFieldHintText:
            text: "Volk suchen..."

    # Scrollbare Völker-Liste
    MDScrollView:
        size_hint_y: 0.4
        do_scroll_x: False
        do_scroll_y: True

        MDBoxLayout:
            id: voelker_liste_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(2)
            padding: [dp(2), dp(2)]

    # Volk-Details ScrollView (enthält Zusatzelemente + Volk-Details)
    MDScrollView:
        size_hint_y: 1
        do_scroll_x: False
        do_scroll_y: True

        MDBoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(8)
            padding: [dp(4), dp(6), dp(4), dp(6)]

            # Zusatzelemente Container (innerhalb ScrollView)
            MDBoxLayout:
                id: zusatzelemente_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)

            # Volk-Details
            MDBoxLayout:
                id: selected_volk_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)

# eigenschaften_view_mobile.kv - Smartphone-optimiertes Layout
# Vertikales Layout pro Eigenschaft: Name oben, Würfel+Buttons unten
# Gleiche Widget-Klassen und IDs wie Desktop-Version

#:import MDIcon kivymd.uix.label.MDIcon

<EigenschaftenWidget>:
    attribute_layout: attribute_layout
    fertigkeiten_layout: fertigkeiten_layout

    MDScrollView:
        size_hint: (1, 1)
        do_scroll_x: False
        do_scroll_y: True
        bar_width: dp(20)
        bar_margin: dp(4)
        scroll_type: ['bars', 'content']
        scroll_timeout: 200
        scroll_distance: dp(20)

        MDBoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            padding: [dp(8), dp(6), dp(8), dp(6)]
            spacing: dp(4)

            MDLabel:
                text: 'Attribute'
                size_hint: (1, None)
                height: dp(32)
                halign: 'left'
                valign: 'middle'
                bold: True

            MDBoxLayout:
                id: attribute_layout
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

            MDLabel:
                text: 'Fertigkeiten'
                size_hint: (1, None)
                height: dp(32)
                halign: 'left'
                valign: 'middle'
                bold: True

            # Sort- und Filter-Buttons kompakt nebeneinander
            MDBoxLayout:
                size_hint_y: None
                height: dp(48)
                spacing: dp(6)

                MDButton:
                    id: sort_button
                    size_hint_x: 0.5
                    on_release: root.toggle_sort_order()

                    MDButtonText:
                        text: root.sort_text
                        theme_text_color: "Primary"
                        font_size: dp(12)

                MDButton:
                    id: filter_button
                    size_hint_x: 0.5
                    on_release: root.toggle_filter_option()

                    MDButtonText:
                        text: root.aktiv_spinner_text if hasattr(root, 'aktiv_spinner_text') else "Alle"
                        theme_text_color: "Primary"
                        font_size: dp(12)

            MDBoxLayout:
                id: fertigkeiten_layout
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

<EigenschaftenItemRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(40)
    spacing: 0
    padding: [dp(4), 0]

    # Name-Label - füllt restlichen Platz (kein dynamisches width)
    MDLabel:
        text: root.item_type == 'fertigkeit' and root.item_obj and root.item_obj.attribut and f"{root.item_name} ({root.item_obj.attribut.attribut_name})" or root.item_name
        size_hint_x: 1
        halign: 'left'
        valign: 'middle'
        font_size: dp(13)
        shorten: True
        shorten_from: 'right'
        text_size: self.size

    # Würfel-Icon-Gruppe kompakt (feste Breite, feste Positionen)
    MDBoxLayout:
        size_hint_x: None
        width: dp(96)
        spacing: 0
        padding: 0

        # Würfel-Icon
        MDIcon:
            icon: root.dice_icon
            theme_icon_color: "Primary"
            size_hint: None, None
            size: dp(24), dp(24)
            pos_hint: {'center_y': 0.5}

        # Modifier-Vorzeichen
        MDIcon:
            icon: root.modifier_sign
            theme_icon_color: "Primary"
            size_hint: None, None
            size: dp(20), dp(20)
            pos_hint: {'center_y': 0.5}
            opacity: 1 if root.has_modifier else 0

        # Erste Ziffer des Modifiers
        MDIcon:
            icon: root.modifier_value_icon
            theme_icon_color: "Primary"
            size_hint: None, None
            size: dp(20), dp(20)
            pos_hint: {'center_y': 0.5}
            opacity: 1 if root.has_modifier else 0

        # Zweite Ziffer (zweistellig)
        MDIcon:
            icon: root.second_digit_icon
            theme_icon_color: "Primary"
            size_hint: None, None
            size: dp(20), dp(20)
            pos_hint: {'center_y': 0.5}
            opacity: 1 if root.has_second_digit else 0

    # Steigern/Senken Buttons (feste Breite)
    MDBoxLayout:
        size_hint_x: None
        width: dp(56)
        spacing: 0

        MDIconButton:
            icon: "arrow-up-thick"
            style: "standard"
            on_release: root.steigere_eigenschaft()
            size_hint: None, None
            size: dp(28), dp(28)
            pos_hint: {'center_y': 0.5}

        MDIconButton:
            icon: "arrow-down-thick"
            style: "standard"
            on_release: root.senke_eigenschaft()
            size_hint: None, None
            size: dp(28), dp(28)
            pos_hint: {'center_y': 0.5}

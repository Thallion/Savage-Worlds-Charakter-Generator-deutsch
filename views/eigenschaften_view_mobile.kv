# eigenschaften_view_mobile.kv - Smartphone-optimiertes Layout
# Vertikales Layout pro Eigenschaft: Name oben, Würfel+Buttons unten
# Gleiche Widget-Klassen und IDs wie Desktop-Version

<EigenschaftenWidget>:
    attribute_layout: attribute_layout
    fertigkeiten_layout: fertigkeiten_layout

    MDScrollView:
        size_hint: (1, 1)
        do_scroll_x: False
        do_scroll_y: True
        bar_width: 0
        scroll_timeout: 200
        scroll_distance: dp(20)

        MDBoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            padding: [dp(8), dp(6), dp(8), dp(6)]
            spacing: dp(4)

            # Charaktergenerierung abschließen Button
            MDButton:
                id: char_gen_button
                size_hint_x: 1
                on_release: root.toggle_char_gen_completed()

                MDButtonText:
                    text: "Generierung abschließen" if not root.char_gen_completed else "Generierung aktivieren"
                    theme_text_color: "Primary" if not root.char_gen_completed else "Custom"
                    text_color: self.theme_cls.primaryColor if root.char_gen_completed else self.theme_cls.onSurfaceColor

            MDLabel:
                text: 'Attribute'
                size_hint: (1, None)
                height: dp(32)
                halign: 'left'
                valign: 'middle'
                bold: True

            MDBoxLayout:
                id: attribute_layout
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

            MDLabel:
                text: 'Fertigkeiten'
                size_hint: (1, None)
                height: dp(32)
                halign: 'left'
                valign: 'middle'
                bold: True

            # Sort- und Filter-Buttons kompakt nebeneinander
            MDBoxLayout:
                size_hint_y: None
                height: dp(48)
                spacing: dp(6)

                MDButton:
                    id: sort_button
                    size_hint_x: 0.5
                    on_release: root.toggle_sort_order()

                    MDButtonText:
                        text: root.sort_text
                        theme_text_color: "Primary"
                        font_size: dp(12)

                MDButton:
                    id: filter_button
                    size_hint_x: 0.5
                    on_release: root.toggle_filter_option()

                    MDButtonText:
                        text: root.aktiv_spinner_text if hasattr(root, 'aktiv_spinner_text') else "Alle"
                        theme_text_color: "Primary"
                        font_size: dp(12)

            MDBoxLayout:
                id: fertigkeiten_layout
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

<EigenschaftenItemRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(40)
    spacing: dp(2)
    padding: [dp(4), 0]

    # Name-Label - responsiv mit Obergrenze
    MDLabel:
        text: root.item_type == 'fertigkeit' and root.item_obj and root.item_obj.attribut and f"{root.item_name} ({root.item_obj.attribut.attribut_name})" or root.item_name
        size_hint_x: None
        width: min(dp(260), self.parent.width - dp(160)) if self.parent else dp(200)
        halign: 'left'
        valign: 'middle'
        font_size: dp(13)
        shorten: True
        shorten_from: 'right'
        text_size: self.size

    # Würfel-Icon-Gruppe kompakt
    MDBoxLayout:
        size_hint_x: None
        width: dp(100)
        spacing: 0

        # Würfel-Icon
        MDIconButton:
            icon: root.dice_icon
            style: "standard"
            theme_icon_color: "Primary"
            size_hint: None, None
            size: dp(26), dp(26)

        # Modifier-Vorzeichen
        MDIconButton:
            icon: root.modifier_sign
            style: "standard"
            theme_icon_color: "Primary"
            size_hint: None, None
            size: dp(22), dp(22)
            opacity: 1 if root.has_modifier else 0

        # Erste Ziffer des Modifiers
        MDIconButton:
            icon: root.modifier_value_icon
            style: "standard"
            theme_icon_color: "Primary"
            size_hint: None, None
            size: dp(22), dp(22)
            opacity: 1 if root.has_modifier else 0

        # Zweite Ziffer (zweistellig)
        MDIconButton:
            icon: root.second_digit_icon
            style: "standard"
            theme_icon_color: "Primary"
            size_hint: None, None
            size: dp(22), dp(22)
            opacity: 1 if root.has_second_digit else 0

    # Steigern/Senken Buttons
    MDBoxLayout:
        size_hint_x: None
        width: dp(52)

        MDIconButton:
            icon: "arrow-up-thick"
            style: "standard"
            on_release: root.steigere_eigenschaft()
            size_hint: None, None
            size: dp(26), dp(26)

        MDIconButton:
            icon: "arrow-down-thick"
            style: "standard"
            on_release: root.senke_eigenschaft()
            size_hint: None, None
            size: dp(26), dp(26)

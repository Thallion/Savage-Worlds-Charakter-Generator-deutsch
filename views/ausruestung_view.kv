<TooltipIconButton>:
    style: "filled"
    size_hint: None, None
    size: dp(40), dp(40)
    MDButtonIcon:
        icon: root.icon
    MDTooltipPlain:
        text: root.tooltip_text

<TooltipFabButton>:
    MDTooltipPlain:
        text: root.tooltip_text

<AusruestungWidget>:
    orientation: 'vertical'
    md_bg_color: app.theme_cls.backgroundColor
    
    # Such- und Filter-Zeile (kompakt, alles in einer Zeile)
    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(72)
        padding: [dp(20), dp(8)]
        spacing: dp(10)

        MDTextField:
            id: search_input
            hint_text: 'Suche...'
            size_hint_x: None
            width: dp(200)
            pos_hint: {'center_y': 0.5}
            on_text: root.filter_ausruestung()

        MDScrollView:
            size_hint_x: 1
            do_scroll_x: True
            do_scroll_y: False
            bar_width: dp(6)

            MDBoxLayout:
                orientation: 'horizontal'
                size_hint_x: None
                width: self.minimum_width
                size_hint_y: 1
                spacing: dp(10)

                MDFabButton:
                    icon: "filter"
                    style: "small"
                    size_hint: None, None
                    size: dp(48), dp(48)
                    pos_hint: {"center_y": 0.5}
                    on_release: root.open_category_menu()

                MDLabel:
                    id: category_label
                    text: 'Alle Kategorien'
                    size_hint_x: None
                    width: dp(140)
                    pos_hint: {"center_y": 0.5}

                MDButton:
                    id: only_owned_button
                    size_hint: None, None
                    width: dp(180)
                    height: dp(48)
                    pos_hint: {"center_y": 0.5}
                    on_release: root.toggle_only_owned_items()

                    MDButtonText:
                        text: "Nur vorhandene" if not root.only_owned_items else "Alle"
                        theme_text_color: "Primary" if not root.only_owned_items else "Custom"
                        text_color: self.theme_cls.primaryColor if root.only_owned_items else self.theme_cls.onSurfaceColor

                TooltipFabButton:
                    id: sort_name_btn
                    tooltip_text: "Sortieren nach Name"
                    icon: "sort-alphabetical-ascending" if root.current_sort_option != 'Name' or root.sort_order == 'asc' else "sort-alphabetical-descending"
                    style: "small"
                    size_hint: None, None
                    size: dp(48), dp(48)
                    pos_hint: {"center_y": 0.5}
                    on_release: root.update_sort_option('Name')

                TooltipFabButton:
                    id: sort_costs_btn
                    tooltip_text: "Sortieren nach Kosten"
                    icon: "sort-numeric-ascending" if root.current_sort_option != 'Kosten' or root.sort_order == 'asc' else "sort-numeric-descending"
                    style: "small"
                    size_hint: None, None
                    size: dp(48), dp(48)
                    pos_hint: {"center_y": 0.5}
                    on_release: root.update_sort_option('Kosten')

                TooltipFabButton:
                    id: sort_category_btn
                    tooltip_text: "Sortieren nach Kategorie"
                    icon: "sort-bool-ascending" if root.current_sort_option != 'Kategorie' or root.sort_order == 'asc' else "sort-bool-descending"
                    style: "small"
                    size_hint: None, None
                    size: dp(48), dp(48)
                    pos_hint: {"center_y": 0.5}
                    on_release: root.update_sort_option('Kategorie')

    MDLabel:
        text: 'Ausrüstung'
        font_size: dp(24)
        size_hint_y: None
        height: dp(48)
        padding: [20, 10]

    # Diagnostische Information anzeigen
    MDLabel:
        id: debug_label
        text: ''
        size_hint_y: None
        height: dp(30) if self.text else 0
        color: 1, 0, 0, 1
        halign: 'center'

    # Verbesserte RecycleView
    MDRecycleView:
        id: recycleview
        viewclass: 'AusruestungItemRow'
        size_hint_y: 1
        
        RecycleBoxLayout:
            id: layout
            default_size: None, dp(100)
            default_size_hint: 1, None
            size_hint_y: None
            height: self.minimum_height
            orientation: 'vertical'
            spacing: dp(10)
            padding: [dp(5), dp(10), dp(15), dp(10)]

<AusruestungItemRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(100)
    spacing: dp(5)
    padding: [dp(5), dp(5), dp(60), dp(5)]
    # THEME-FIX: md_bg_color entfernt - wird jetzt im Python-Code gesetzt
    
    # Hauptcontainer für Name, Beschreibung und Details
    MDBoxLayout:
        orientation: 'vertical'
        size_hint_x: 0.35
        spacing: dp(8)
        padding: [0, dp(5), 0, dp(5)]
        
        # Name - größer und fett
        MDLabel:
            text: root.name
            font_size: dp(14)
            bold: True
            size_hint_y: None
            height: dp(20)
            halign: 'left'
            valign: 'middle'
            text_size: self.width, None
            theme_text_color: "Primary"  # THEME-FIX: Automatische Textfarbe
            
        # Beschreibung - nur wenn vorhanden
        MDLabel:
            text: root.beschreibung if root.beschreibung else ""
            font_size: dp(11)
            theme_text_color: "Secondary"
            size_hint_y: None
            height: dp(20) if root.beschreibung else 0
            opacity: 1 if root.beschreibung else 0
            halign: 'left'
            valign: 'top'
            text_size: self.width, None
            markup: True
            max_lines: 1
            
        # Details - nur wenn vorhanden  
        MDLabel:
            text: root.details if root.details else ""
            font_size: dp(11)
            theme_text_color: "Secondary"
            size_hint_y: None
            height: dp(16) if root.details else 0
            opacity: 1 if root.details else 0
            halign: 'left'
            valign: 'middle'
            text_size: self.width, None
    
    # Info-Button als eigene Spalte
    MDFabButton:
        icon: "information-outline"
        style: "small"
        size_hint: None, None
        size: dp(32), dp(32)
        pos_hint: {"center_y": 0.5}
        on_release: root.show_full_description()
        opacity: 1 if root.beschreibung else 0
        disabled: not root.beschreibung
    
    # Kategorie
    MDLabel:
        text: root.kategorie.capitalize() if root.kategorie else "Unbekannt"
        font_size: dp(14)
        size_hint_x: 0.12
        halign: 'left'
        valign: 'middle'
        pos_hint: {'center_y': 0.5}
        text_size: self.width, None
        shorten: True
        theme_text_color: "Primary"  # THEME-FIX
    
    # Gewicht
    MDLabel:
        text: f"{root.gewicht} kg"
        font_size: dp(14)
        size_hint_x: 0.08
        halign: 'left'
        valign: 'middle'
        pos_hint: {'center_y': 0.5}
        theme_text_color: "Primary"  # THEME-FIX
    
    # Kosten
    MDLabel:
        text: f"{root.kosten} {root.waehrungseinheit}"
        font_size: dp(14)
        size_hint_x: 0.12
        halign: 'left'
        valign: 'middle'
        pos_hint: {'center_y': 0.5}
        text_size: self.width, None
        shorten: True
        theme_text_color: "Primary"  # THEME-FIX
    
    # Menge
    MDLabel:
        text: str(root.menge)
        font_size: dp(14)
        size_hint_x: 0.04
        halign: 'center'
        valign: 'middle'
        pos_hint: {'center_y': 0.5}
        theme_text_color: "Primary"  # THEME-FIX
    
    # Action-Buttons
    MDFabButton:
        icon: "plus"
        style: "small"
        size_hint: None, None
        size: dp(35), dp(35)
        pos_hint: {"center_y": 0.5}
        on_release: root.kaufen_ausruestung()

    MDFabButton:
        icon: "minus"
        style: "small"
        size_hint: None, None
        size: dp(35), dp(35)
        pos_hint: {"center_y": 0.5}
        on_release: root.verkaufen_ausruestung()

    MDFabButton:
        icon: "pencil"
        style: "small"
        size_hint: None, None
        size: dp(35), dp(35)
        pos_hint: {"center_y": 0.5}
        on_release: root.bearbeite_ausruestung()
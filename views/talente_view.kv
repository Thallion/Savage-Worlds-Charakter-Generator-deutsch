<TooltipIconButton>
    MDTooltipPlain:
        text: root.tooltip_text

<TooltipFabButton>
    MDTooltipPlain:
        text: root.tooltip_text

<TalenteWidget>:
    orientation: 'vertical'
    md_bg_color: self.theme_cls.backgroundColor  
    
    # Such- und Filter-Zeile (kompakt, alles in einer Zeile)
    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(72)
        padding: [dp(20), dp(8)]
        spacing: dp(10)

        MDTextField:
            id: search_input
            hint_text: 'Suche...'
            size_hint_x: None
            width: dp(200)
            pos_hint: {'center_y': 0.5}
            on_text: root.filter_talente()

        MDScrollView:
            size_hint_x: 1
            do_scroll_x: True
            do_scroll_y: False
            bar_width: dp(6)

            MDBoxLayout:
                orientation: 'horizontal'
                size_hint_x: None
                width: self.minimum_width
                size_hint_y: 1
                spacing: dp(10)

                MDFabButton:
                    icon: "filter"
                    style: "small"
                    size_hint: None, None
                    size: dp(48), dp(48)
                    pos_hint: {"center_y": 0.5}
                    on_release: root.open_category_menu()

                MDLabel:
                    id: category_label
                    text: 'Alle Kategorien'
                    size_hint_x: None
                    width: dp(140)
                    pos_hint: {"center_y": 0.5}

                MDButton:
                    id: only_selected_button
                    size_hint: None, None
                    width: dp(180)
                    height: dp(48)
                    pos_hint: {"center_y": 0.5}
                    on_release: root.toggle_only_selected_items()

                    MDButtonText:
                        text: "Nur ausgewählte" if not root.only_selected_items else "Alle"
                        theme_text_color: "Primary" if not root.only_selected_items else "Custom"
                        text_color: self.theme_cls.primaryColor if root.only_selected_items else self.theme_cls.onSurfaceColor

                MDButton:
                    id: only_available_button
                    size_hint: None, None
                    width: dp(200)
                    height: dp(48)
                    pos_hint: {"center_y": 0.5}
                    on_release: root.toggle_only_available_talents()

                    MDButtonText:
                        text: "Voraussetzung erfüllt" if not root.only_available_talents else "Alle Talente"
                        theme_text_color: "Primary" if not root.only_available_talents else "Custom"
                        text_color: self.theme_cls.primaryColor if root.only_available_talents else self.theme_cls.onSurfaceColor

                TooltipFabButton:
                    id: sort_name_btn
                    tooltip_text: "Sortieren nach Name"
                    icon: "sort-alphabetical-ascending" if root.current_sort_option != 'Name' or root.sort_order == 'asc' else "sort-alphabetical-descending"
                    style: "small"
                    size_hint: None, None
                    size: dp(48), dp(48)
                    pos_hint: {"center_y": 0.5}
                    on_release: root.update_sort_option('Name')

                TooltipFabButton:
                    id: sort_rank_btn
                    tooltip_text: "Sortieren nach Rang"
                    icon: "sort-numeric-ascending" if root.current_sort_option != 'Rang' or root.sort_order == 'asc' else "sort-numeric-descending"
                    style: "small"
                    size_hint: None, None
                    size: dp(48), dp(48)
                    pos_hint: {"center_y": 0.5}
                    on_release: root.update_sort_option('Rang')

                TooltipFabButton:
                    id: sort_category_btn
                    tooltip_text: "Sortieren nach Kategorie"
                    icon: "sort-bool-ascending" if root.current_sort_option != 'Kategorie' or root.sort_order == 'asc' else "sort-bool-descending"
                    style: "small"
                    size_hint: None, None
                    size: dp(48), dp(48)
                    pos_hint: {"center_y": 0.5}
                    on_release: root.update_sort_option('Kategorie')

    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(48)
        padding: [20, 10, 20, 0]
        
        MDLabel:
            text: 'Talente'
            font_size: dp(24)
            halign: 'left'
            
    TalenteRecycleView:
        id: recycleview
        viewclass: 'TalentItemRow'
        size_hint_y: 1
        
        RecycleBoxLayout:
            id: layout
            default_size: None, dp(60)
            default_size_hint: 1, None
            size_hint_y: None
            height: self.minimum_height
            orientation: 'vertical'
            spacing: dp(5)
            padding: dp(20)

<TalentItemRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(60)
    md_bg_color: self._get_background_color()
    line_color: self._get_line_color()
    line_width: 2
    spacing: dp(10)
    padding: dp(10)

    MDLabel:
        text: root.talent_name
        font_size: dp(16)
        size_hint_x: 0.2
        halign: 'left'
        valign: 'middle'

    MDLabel:
        text: root.kategorie
        font_size: dp(16)
        size_hint_x: 0.15
        halign: 'left'
        valign: 'middle'

    MDLabel:
        text: root.rang
        font_size: dp(16)
        size_hint_x: 0.1
        halign: 'left'
        valign: 'middle'

    MDFabButton:
        icon: "plus"
        style: "small"
        size_hint: None, None
        size: dp(40), dp(40)
        pos_hint: {"center_y": 0.5}
        on_release: root.waehle_talent()
        disabled: False

    MDFabButton:
        icon: "minus"
        style: "small"
        size_hint: None, None
        size: dp(40), dp(40)
        pos_hint: {"center_y": 0.5}
        on_release: root.entferne_talent()
        disabled: not root.ausgewaehlt

    # Neuer Bearbeiten-Button
    MDFabButton:
        icon: "pencil"
        style: "small"
        size_hint: None, None
        size: dp(40), dp(40)
        pos_hint: {"center_y": 0.5}
        on_release: root.bearbeite_talent()

    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_x: 0.4
        spacing: dp(5)
        
        MDLabel:
            id: beschreibung_label
            text: root.beschreibung
            font_size: dp(14)
            halign: 'left'
            valign: 'top'
            text_size: self.width, None
            markup: True
            max_lines: 2
            
        MDFabButton:
            icon: "information-outline"
            style: "small"
            size_hint: None, None
            size: dp(32), dp(32)
            pos_hint: {"center_y": 0.5}
            on_release: root.show_full_description()
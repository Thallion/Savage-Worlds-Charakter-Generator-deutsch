<VoelkerWidget>:
    orientation: 'vertical'
    md_bg_color: self.theme_cls.backgroundColor
    padding: [dp(10), dp(8), dp(10), dp(8)]
    spacing: dp(10)

    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(35)
        
        MDLabel:
            text: "Abstammungen"
            size_hint_x: 1
            halign: 'left'
            font_style: "Title"
            theme_text_color: "Primary"

        # Buttons für Abstammungs-Management
        MDIconButton:
            icon: "plus"
            tooltip: "Abstammung erstellen"
            on_release: root.open_add_volk_dialog()

        MDIconButton:
            id: edit_volk_button
            icon: "pencil"
            tooltip: "Abstammung bearbeiten"
            on_release: root.open_edit_volk_dialog()

        MDIconButton:
            icon: "delete"
            tooltip: "Abstammung löschen"
            on_release: root.open_delete_volk_dialog()

    # KOMPAKTE VÖLKER-AUSWAHL - responsiv
    MDCard:
        size_hint_x: 1
        size_hint_y: None
        height: dp(80)
        padding: dp(12)
        elevation: 2
        radius: [10]
        md_bg_color: self.theme_cls.surfaceContainerLowColor
        style: "elevated"

        MDBoxLayout:
            orientation: 'horizontal'
            spacing: dp(15)
            
            MDLabel:
                text: "Gewählte Abstammung:"
                font_style: "Body"
                theme_text_color: "Primary"
                size_hint_x: 0.3
                halign: 'left'
                valign: 'center'

            # DROPDOWN für Abstammungs-Auswahl
            MDButton:
                id: volk_dropdown_button
                style: "outlined"
                size_hint_x: 0.7
                size_hint_y: None
                height: dp(48)
                on_release: root.open_volk_dropdown()

                MDButtonText:
                    id: selected_volk_text
                    text: "Abstammung auswählen..."

    # Zusatzelemente Container
    MDBoxLayout:
        id: zusatzelemente_container
        orientation: 'vertical'
        size_hint_y: None
        height: self.minimum_height
        spacing: dp(10)

    # Ausgewähltes Volk Details in eigenem ScrollView
    MDScrollView:
        size_hint_y: 1
        do_scroll_x: False
        do_scroll_y: True
        bar_width: dp(15)
        bar_margin: dp(8)
        scroll_wheel_distance: dp(114)

        MDBoxLayout:
            id: selected_volk_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(12)
            padding: [dp(12), dp(10), dp(12), dp(10)]
# pointbar_view_mobile.kv - Smartphone-optimiertes Layout
# MDExpansionPanel für zuverlässiges Ein-/Ausklappen auf Android
# Kompakte LabelValuePair-Zeilen statt schwerer Cards

#:import MDExpansionPanel kivymd.uix.expansionpanel.MDExpansionPanel
#:import MDExpansionPanelHeader kivymd.uix.expansionpanel.MDExpansionPanelHeader
#:import MDExpansionPanelContent kivymd.uix.expansionpanel.MDExpansionPanelContent
#:import MDDivider kivymd.uix.divider.MDDivider

<LabelValuePair>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(20)
    spacing: dp(4)
    padding: [dp(16), 0, dp(8), 0]

    MDLabel:
        text: root.key_text
        theme_text_color: "Secondary"
        halign: 'left'
        valign: 'center'
        size_hint_x: root.key_width_ratio
        font_size: dp(11)
        shorten: True
        shorten_from: 'right'
        text_size: self.size

    MDLabel:
        text: root.value_text
        theme_text_color: "Primary"
        halign: 'left'
        valign: 'center'
        size_hint_x: 1 - root.key_width_ratio
        font_size: dp(11)
        bold: True
        shorten: True
        shorten_from: 'right'
        text_size: self.size

<GenerationPointsBar>:
    orientation: 'vertical'
    spacing: 0
    size_hint_y: None
    height: self.minimum_height
    md_bg_color: app.theme_cls.backgroundColor

    # Status-Button: immer sichtbar, über der Pointbar
    MDBoxLayout:
        id: char_gen_bar
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(32)
        padding: [dp(8), dp(2), dp(8), dp(2)]
        md_bg_color: app.theme_cls.surfaceContainerHighColor if not root.char_gen_completed else app.theme_cls.primaryContainerColor

        MDButton:
            id: char_gen_status_button
            style: "text"
            size_hint_x: 1
            on_release: root.toggle_char_gen_completed()

            MDButtonIcon:
                icon: "check-circle" if root.char_gen_completed else "progress-wrench"

            MDButtonText:
                text: "Aufstiege freigeschaltet" if root.char_gen_completed else "Erstellung abschließen"
                font_size: dp(11)

    MDExpansionPanel:
        id: expansion_panel
        size_hint_y: None
        height: self.minimum_height

        MDExpansionPanelHeader:
            MDListItem:
                theme_bg_color: "Custom"
                md_bg_color: app.theme_cls.surfaceContainerLowColor
                ripple_effect: False
                size_hint_y: None
                height: dp(44)

                MDListItemLeadingAvatar:
                    source: root.get_logo_path()

                MDListItemSupportingText:
                    text: root.header_summary_text
                    theme_text_color: "Primary"
                    bold: True

                TrailingPressedIconButton:
                    id: chevron
                    icon: "chevron-right"
                    on_release: root.toggle_panel()

        MDExpansionPanelContent:
            id: content_box
            orientation: "vertical"
            padding: [0, dp(4), 0, dp(4)]
            size_hint_y: None
            height: self.minimum_height

            # Charakterdaten
            LabelValuePair:
                key_text: "Name:"
                value_text: root.char_name_text
                key_width_ratio: 0.40

            LabelValuePair:
                key_text: "Setting:"
                value_text: root.active_setting_name_text
                key_width_ratio: 0.40

            LabelValuePair:
                key_text: "Rang:"
                value_text: root.rang_text
                key_width_ratio: 0.40

            LabelValuePair:
                key_text: "Aufstiege:"
                value_text: root.aufstiege_text
                key_width_ratio: 0.40

            # Trennlinie
            MDDivider:
                size_hint_y: None
                height: dp(1)

            # Generierungspunkte
            LabelValuePair:
                key_text: "Attribute:"
                value_text: root.attribut_text
                key_width_ratio: 0.50

            LabelValuePair:
                key_text: "Fertigkeiten:"
                value_text: root.faehigkeiten_text
                key_width_ratio: 0.50

            LabelValuePair:
                key_text: "Handicaps:"
                value_text: root.handicaps_text
                key_width_ratio: 0.50

            LabelValuePair:
                key_text: "Mächte:"
                value_text: root.maechte_text
                key_width_ratio: 0.50
                size_hint_y: None
                height: dp(20) if root.maechte_text else 0
                opacity: 1 if root.maechte_text else 0

            LabelValuePair:
                key_text: "SKP:"
                value_text: root.superkraft_punkte_text
                key_width_ratio: 0.50
                size_hint_y: None
                height: dp(20) if root.superkraft_punkte_text else 0
                opacity: 1 if root.superkraft_punkte_text else 0

            # Trennlinie
            MDDivider:
                size_hint_y: None
                height: dp(1)

            # Ressourcen
            LabelValuePair:
                key_text: "Machtstufe:"
                value_text: root.machtstufe_text
                key_width_ratio: 0.50
                size_hint_y: None
                height: dp(20) if root.machtstufe_text else 0
                opacity: 1 if root.machtstufe_text else 0

            LabelValuePair:
                key_text: "Machtpunkte:"
                value_text: root.machtpunkte_text
                key_width_ratio: 0.50
                size_hint_y: None
                height: dp(20) if root.machtpunkte_text else 0
                opacity: 1 if root.machtpunkte_text else 0

            LabelValuePair:
                key_text: "Parade / Rob.:"
                value_text: root.parade_robustheit_text
                key_width_ratio: 0.50

            LabelValuePair:
                key_text: "Gewicht:"
                value_text: root.gewicht_text
                key_width_ratio: 0.50

            LabelValuePair:
                key_text: "Vermögen:"
                value_text: root.vermoegen_text
                key_width_ratio: 0.50


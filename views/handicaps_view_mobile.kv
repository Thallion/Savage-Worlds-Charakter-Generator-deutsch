# handicaps_view_mobile.kv - Smartphone-optimiertes Layout
# Beschreibungen ausgeblendet, nur per Info-Button erreichbar
# Name + Stufe + Buttons kompakt in einer Zeile

<TooltipFabButton>:
    MDTooltipPlain:
        text: root.tooltip_text

<HandicapsWidget>:
    orientation: 'vertical'
    md_bg_color: self.theme_cls.backgroundColor

    # Suchfeld kompakt
    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(64)
        padding: [dp(8), dp(6)]
        spacing: dp(6)

        MDTextField:
            id: search_input
            hint_text: 'Suche...'
            size_hint_x: 1
            on_text: root.filter_handicaps()

        MDIconButton:
            id: filter_chevron
            icon: "chevron-down" if root.is_filter_expanded else "chevron-right"
            size_hint: None, None
            width: dp(40)
            height: dp(40)
            pos_hint: {'center_y': 0.5}
            on_release: root.toggle_filter_panel()

    # Filter-Buttons kompakt, horizontal scrollbar
    MDScrollView:
        id: filter_container
        size_hint_y: None
        height: dp(56)
        do_scroll_x: True
        do_scroll_y: False

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_x: None
            width: self.minimum_width
            size_hint_y: None
            height: dp(48)
            padding: [dp(8), dp(4)]
            spacing: dp(6)

            TooltipFabButton:
                tooltip_text: "Name sortieren"
                icon: "sort-alphabetical-ascending" if root.sort_order == 'name_asc' else "sort-alphabetical-descending"
                style: "small"
                size_hint: None, None
                size: dp(40), dp(40)
                on_release: root.toggle_sort_order()

            MDButton:
                id: only_selected_button
                size_hint: None, None
                height: dp(40)
                on_release: root.toggle_only_selected_items()

                MDButtonText:
                    text: "Gewählt" if not root.only_selected_items else "Alle"
                    theme_text_color: "Primary" if not root.only_selected_items else "Custom"
                    text_color: self.theme_cls.primaryColor if root.only_selected_items else self.theme_cls.onSurfaceColor
                    font_size: dp(12)

            MDFabButton:
                icon: "filter"
                style: "small"
                size_hint: None, None
                size: dp(40), dp(40)
                on_release: root.open_category_menu()

            MDLabel:
                id: category_label
                text: 'Alle Stufen'
                size_hint_x: None
                width: dp(80)
                font_size: dp(12)

    MDLabel:
        text: 'Handicaps'
        font_size: dp(18)
        size_hint_y: None
        height: dp(32)
        padding: [dp(8), dp(4)]
        bold: True

    HandicapsRecycleView:
        id: recycleview
        viewclass: 'HandicapItemRow'
        size_hint_y: 1

        RecycleBoxLayout:
            id: layout
            default_size: None, dp(48)
            default_size_hint: 1, None
            size_hint_y: None
            height: self.minimum_height
            orientation: 'vertical'
            spacing: dp(2)
            padding: [dp(4), dp(4)]

# Kompakte Handicap-Zeile: Name | Stufe | +/- Buttons | Info
# KEINE Beschreibung inline
<HandicapItemRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(48)
    md_bg_color: self._get_background_color()
    line_color: self._get_line_color()
    line_width: 2
    spacing: dp(4)
    padding: [dp(6), dp(4)]

    # Name
    MDLabel:
        text: root.handicap_name
        font_size: dp(13)
        size_hint_x: 1
        halign: 'left'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'
        text_size: self.size

    # Stufe kompakt
    MDLabel:
        text: root.stufe.capitalize() if root.stufe else "?"
        font_size: dp(12)
        size_hint_x: None
        width: dp(60)
        halign: 'center'
        valign: 'middle'

    # Action-Buttons
    MDFabButton:
        icon: "plus"
        style: "small"
        size_hint: None, None
        size: dp(36), dp(36)
        pos_hint: {"center_y": 0.5}
        on_release: root.waehle_handicap()

    MDFabButton:
        icon: "minus"
        style: "small"
        size_hint: None, None
        size: dp(36), dp(36)
        pos_hint: {"center_y": 0.5}
        on_release: root.entferne_handicap()
        disabled: not root.ausgewaehlt

    MDFabButton:
        icon: "pencil"
        style: "small"
        size_hint: None, None
        size: dp(36), dp(36)
        pos_hint: {"center_y": 0.5}
        on_release: root.bearbeite_handicap()

    # Info-Button für Beschreibung
    MDFabButton:
        icon: "information-outline"
        style: "small"
        size_hint: None, None
        size: dp(32), dp(32)
        pos_hint: {"center_y": 0.5}
        on_release: root.show_full_description()

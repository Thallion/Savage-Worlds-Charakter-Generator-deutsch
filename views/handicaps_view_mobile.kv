# handicaps_view_mobile.kv - Smartphone-optimiertes Layout
# Beschreibungen ausgeblendet, nur per Info-Button erreichbar
# Name + Stufe + Buttons kompakt in einer Zeile

<TooltipFabButton>:
    MDTooltipPlain:
        text: root.tooltip_text

<HandicapsWidget>:
    orientation: 'vertical'
    md_bg_color: self.theme_cls.backgroundColor

    # Suchfeld und Filter-Buttons in einer Zeile, horizontal scrollbar
    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(44)
        padding: [dp(4), dp(2)]
        spacing: dp(4)

        MDTextField:
            id: search_input
            hint_text: 'Suche...'
            size_hint_x: None
            width: dp(110)
            on_text: root.filter_handicaps()

        MDScrollView:
            id: filter_container
            size_hint_x: 1
            do_scroll_x: True
            do_scroll_y: False

            MDBoxLayout:
                orientation: 'horizontal'
                size_hint_x: None
                width: self.minimum_width
                size_hint_y: None
                height: dp(40)
                spacing: dp(4)

                MDFabButton:
                    icon: "filter"
                    style: "small"
                    size_hint: None, None
                    size: dp(36), dp(36)
                    on_release: root.open_category_menu()

                MDLabel:
                    id: category_label
                    text: 'Alle Stufen'
                    size_hint_x: None
                    width: dp(80)
                    font_size: dp(11)

                TooltipFabButton:
                    id: only_selected_button
                    tooltip_text: "Nur ausgewählte / Alle"
                    icon: "sort-bool-descending-variant" if not root.only_selected_items else "sort-bool-ascending-variant"
                    style: "small"
                    size_hint: None, None
                    size: dp(36), dp(36)
                    on_release: root.toggle_only_selected_items()

                TooltipFabButton:
                    tooltip_text: "Name sortieren"
                    icon: "sort-alphabetical-ascending" if root.sort_order == 'name_asc' else "sort-alphabetical-descending"
                    style: "small"
                    size_hint: None, None
                    size: dp(36), dp(36)
                    on_release: root.toggle_sort_order()

    MDLabel:
        text: 'Handicaps'
        font_size: dp(16)
        size_hint_y: None
        height: dp(28)
        padding: [dp(4), dp(2)]
        bold: True

    HandicapsRecycleView:
        id: recycleview
        viewclass: 'HandicapItemRow'
        size_hint_y: 1

        RecycleBoxLayout:
            id: layout
            default_size: None, dp(38)
            default_size_hint: 1, None
            size_hint_y: None
            height: self.minimum_height
            orientation: 'vertical'
            spacing: dp(2)
            padding: [dp(2), dp(2)]

# Kompakte Handicap-Zeile: Name | Stufe | +/- Buttons | Info
<HandicapItemRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(38)
    md_bg_color: self._get_background_color()
    line_color: self._get_line_color()
    line_width: 2
    spacing: dp(2)
    padding: [dp(4), dp(2)]

    # Name - responsiv mit Obergrenze
    MDLabel:
        text: root.handicap_name
        font_size: dp(11)
        size_hint_x: None
        width: min(dp(250), self.parent.width - dp(230)) if self.parent else dp(200)
        halign: 'left'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'
        text_size: self.size

    # Stufe kompakt
    MDLabel:
        text: root.stufe.capitalize() if root.stufe else "?"
        font_size: dp(9)
        size_hint_x: None
        width: dp(58)
        halign: 'center'
        valign: 'middle'

    # Action-Buttons
    MDFabButton:
        icon: "plus"
        style: "small"
        size_hint: None, None
        size: dp(30), dp(30)
        pos_hint: {"center_y": 0.5}
        on_release: root.waehle_handicap()

    MDFabButton:
        icon: "minus"
        style: "small"
        size_hint: None, None
        size: dp(30), dp(30)
        pos_hint: {"center_y": 0.5}
        on_release: root.entferne_handicap()
        disabled: not root.ausgewaehlt

    MDFabButton:
        icon: "pencil"
        style: "small"
        size_hint: None, None
        size: dp(30), dp(30)
        pos_hint: {"center_y": 0.5}
        on_release: root.bearbeite_handicap()

    # Info-Button
    MDFabButton:
        icon: "information-outline"
        style: "small"
        size_hint: None, None
        size: dp(28), dp(28)
        pos_hint: {"center_y": 0.5}
        on_release: root.show_full_description()

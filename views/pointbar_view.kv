<LabelValuePair>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(24)
    spacing: dp(8)

    MDLabel:
        text: root.key_text
        theme_text_color: "Primary"
        halign: 'left'
        valign: 'center'
        size_hint_x: root.key_width_ratio
        font_size: dp(11)
        shorten: True
        shorten_from: 'right'
        text_size: self.size

    MDLabel:
        text: root.value_text
        theme_text_color: "Secondary"
        halign: 'left'
        valign: 'center'
        size_hint_x: 1 - root.key_width_ratio
        font_size: dp(11)
        bold: True
        shorten: True
        shorten_from: 'right'
        text_size: self.size

<GenerationPointsBar>:
    orientation: 'vertical'
    spacing: 0
    size_hint_y: None
    height: self.minimum_height
    md_bg_color: app.theme_cls.backgroundColor

    # ───── Toolbar (immer sichtbar) ─────
    MDBoxLayout:
        id: toolbar
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(48)
        padding: [dp(4), dp(4), dp(4), dp(4)]
        spacing: dp(2)
        md_bg_color: app.theme_cls.surfaceContainerColor

        # Chevron — klappt Detail-Bereich auf/zu
        MDIconButton:
            icon: "chevron-down" if root.is_expanded else "chevron-right"
            style: "standard"
            size_hint: None, None
            size: [dp(40), dp(40)]
            pos_hint: {'center_y': 0.5}
            on_release: root.toggle_panel()

        # Zusammenfassung
        MDLabel:
            text: root.header_summary_text
            theme_text_color: "Primary"
            halign: 'left'
            valign: 'center'
            font_size: dp(12)
            bold: True
            shorten: True
            shorten_from: 'right'
            text_size: self.size
            size_hint_x: 1

        # Undo
        MDIconButton:
            icon: "undo"
            style: "standard"
            size_hint: None, None
            size: [dp(40), dp(40)]
            pos_hint: {'center_y': 0.5}
            disabled: not root.kann_undo
            opacity: 1 if root.kann_undo else 0.3
            on_release: root.on_undo_pressed()

        # Schnellspeichern
        MDIconButton:
            icon: "content-save"
            style: "standard"
            size_hint: None, None
            size: [dp(40), dp(40)]
            pos_hint: {'center_y': 0.5}
            on_release: root.on_schnellspeichern()

        # Laden
        MDIconButton:
            icon: "folder-open"
            style: "standard"
            size_hint: None, None
            size: [dp(40), dp(40)]
            pos_hint: {'center_y': 0.5}
            on_release: root.on_laden()

        # CharGen-Toggle
        MDIconButton:
            icon: "check-circle" if root.char_gen_completed else "progress-wrench"
            style: "standard"
            size_hint: None, None
            size: [dp(40), dp(40)]
            pos_hint: {'center_y': 0.5}
            on_release: root.toggle_char_gen_completed()

    # ───── Detail-Inhalt (ein-/ausklappbar) ─────
    MDBoxLayout:
        id: content_box
        orientation: 'horizontal'
        spacing: dp(12) if root.is_expanded else 0
        size_hint_y: None
        height: self.minimum_height if root.is_expanded else 0
        padding: [dp(12), dp(8), dp(12), dp(8)] if root.is_expanded else [0, 0, 0, 0]
        opacity: 1 if root.is_expanded else 0
        disabled: not root.is_expanded

        # Logo-Container (nur bei breitem Fenster sichtbar)
        MDCard:
            id: logo_card
            style: "elevated"
            size_hint_x: None
            width: dp(130) if self.parent and self.parent.width > dp(700) else 0
            size_hint_y: None
            height: dp(116) if self.width > 0 else 0
            opacity: 1 if self.width > 0 else 0
            md_bg_color: app.theme_cls.surfaceColor
            elevation: 1
            radius: [dp(6)]
            padding: dp(4)

            Image:
                source: root.get_logo_path()
                size_hint: 1, 1
                allow_stretch: True
                keep_ratio: True
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}

        # Hauptinformations-Container
        MDBoxLayout:
            orientation: 'horizontal'
            spacing: dp(10)
            size_hint_x: 1

            # Erste Spalte: Charakterdaten
            MDCard:
                style: "elevated"
                padding: dp(8)
                spacing: dp(2)
                size_hint_x: 0.33
                size_hint_y: None
                height: self.minimum_height
                md_bg_color: app.theme_cls.surfaceColor
                elevation: 1
                radius: [dp(6)]

                MDBoxLayout:
                    orientation: 'vertical'
                    spacing: dp(1)
                    adaptive_height: True

                    LabelValuePair:
                        key_text: "Name:"
                        value_text: root.char_name_text
                        key_width_ratio: 0.35

                    LabelValuePair:
                        key_text: "Setting:"
                        value_text: root.active_setting_name_text
                        key_width_ratio: 0.35

                    LabelValuePair:
                        key_text: "Rang:"
                        value_text: root.rang_text
                        key_width_ratio: 0.35

                    LabelValuePair:
                        key_text: "Aufstiege:"
                        value_text: root.aufstiege_text
                        key_width_ratio: 0.35

            # Zweite Spalte: Generierungspunkte
            MDCard:
                style: "elevated"
                padding: dp(8)
                spacing: dp(2)
                size_hint_x: 0.34
                size_hint_y: None
                height: self.minimum_height
                md_bg_color: app.theme_cls.surfaceColor
                elevation: 1
                radius: [dp(6)]

                MDBoxLayout:
                    orientation: 'vertical'
                    spacing: dp(1)
                    adaptive_height: True

                    LabelValuePair:
                        key_text: "Attribute:"
                        value_text: root.attribut_text
                        key_width_ratio: 0.55

                    LabelValuePair:
                        key_text: "Fertigkeiten:"
                        value_text: root.faehigkeiten_text
                        key_width_ratio: 0.55

                    LabelValuePair:
                        key_text: "Handicaps:"
                        value_text: root.handicaps_text
                        key_width_ratio: 0.55

                    LabelValuePair:
                        key_text: "Mächte:"
                        value_text: root.maechte_text
                        key_width_ratio: 0.55
                        size_hint_y: None
                        height: dp(24) if root.maechte_text else 0
                        opacity: 1 if root.maechte_text else 0

                    LabelValuePair:
                        key_text: "SKP:"
                        value_text: root.superkraft_punkte_text
                        key_width_ratio: 0.55
                        size_hint_y: None
                        height: dp(24) if root.superkraft_punkte_text else 0
                        opacity: 1 if root.superkraft_punkte_text else 0


            # Dritte Spalte: Ressourcen
            MDCard:
                style: "elevated"
                padding: dp(8)
                spacing: dp(2)
                size_hint_x: 0.33
                size_hint_y: None
                height: self.minimum_height
                md_bg_color: app.theme_cls.surfaceColor
                elevation: 1
                radius: [dp(6)]

                MDBoxLayout:
                    orientation: 'vertical'
                    spacing: dp(1)
                    adaptive_height: True

                    LabelValuePair:
                        key_text: "Machtstufe:"
                        value_text: root.machtstufe_text
                        key_width_ratio: 0.55
                        size_hint_y: None
                        height: dp(24) if root.machtstufe_text else 0
                        opacity: 1 if root.machtstufe_text else 0

                    LabelValuePair:
                        key_text: "Machtpunkte:"
                        value_text: root.machtpunkte_text
                        key_width_ratio: 0.55
                        size_hint_y: None
                        height: dp(24) if root.machtpunkte_text else 0
                        opacity: 1 if root.machtpunkte_text else 0

                    LabelValuePair:
                        key_text: "Parade / Rob.:"
                        value_text: root.parade_robustheit_text
                        key_width_ratio: 0.55

                    LabelValuePair:
                        key_text: "Gewicht:"
                        value_text: root.gewicht_text
                        key_width_ratio: 0.55

                    LabelValuePair:
                        key_text: "Vermögen:"
                        value_text: root.vermoegen_text
                        key_width_ratio: 0.55
